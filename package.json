{
  "name": "langchain-toolstem",
  "version": "0.1.4",
  "description": "LangChain.js tools wrapping Toolstem MCP servers (Finance + SEC EDGAR) with x402 USDC micropayments.",
  "license": "MIT",
  "author": "Toolstem <admin@toolstem.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/toolstem/langchain-toolstem.git"
  },
  "keywords": [
    "langchain",
    "mcp",
    "finance",
    "sec",
    "x402",
    "agents",
    "langgraph",
    "toolstem"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./finance": {
      "import": "./dist/finance.js",
      "types": "./dist/finance.d.ts"
    },
    "./sec": {
      "import": "./dist/sec.js",
      "types": "./dist/sec.d.ts"
    },
    "./x402": {
      "import": "./dist/x402.js",
      "types": "./dist/x402.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:live": "npm run build && tsx --test __tests__/discovery.live.test.ts",
    "test:paid": "npm run build && tsx --test __tests__/paid-call.live.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "peerDependencies": {
    "@langchain/langgraph": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
